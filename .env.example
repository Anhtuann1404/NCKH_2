# Cấu hình DeepSeek API
# Đăng ký và lấy API Key tại: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Mô hình mặc định
# deepseek-reasoner: DeepSeek-R1 (chuyên suy luận sâu, giải toán, thiết kế thuật toán, brainstorm)
# deepseek-chat: DeepSeek-V3 (chuyên code nhanh, sinh văn bản, thực thi task)
DEEPSEEK_MODEL_REASONING=deepseek-reasoner
DEEPSEEK_MODEL_CODING=deepseek-chat
